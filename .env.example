# Copy to .env and fill in yourself. Never commit the real .env file.

# Your Talk space, e.g. https://mycompany.ktalk.ru
KTALK_SPACE_URL=https://your-space.ktalk.ru

# --- Pick ONE auth mode ---

# Option A: session token (recommended -- not scope-limited).
# On a tab where you're logged into your space, DevTools -> Console:
#   copy(JSON.parse(localStorage.session).data.token)
# then paste the copied value here. Expires in ~30 days; re-extract when
# tools start returning 401.
KTALK_SESSION_TOKEN=

# Option B: API key (personal or domain), sent as X-Auth-Token.
# avatar -> Settings -> API keys (personal) or admin panel -> API keys (domain).
# NOTE: a personal key typically cannot reach recordings/transcripts at all --
# see docs/api-reference.md. Leave KTALK_SESSION_TOKEN empty to use this instead.
KTALK_API_KEY=

# Optional: force a mode instead of auto-detecting from which var is set above.
# KTALK_AUTH_MODE=session
